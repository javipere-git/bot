# Credenciales: NUNCA subir tokens
config/credentials.ini

# EXCLUIDAS: los archivos que ESCRIBE LA APP no van al repositorio. Un archivo
# que la app reescribe sola choca con el repo en cada actualizacion y te deja sin
# poder actualizar (paso el 18/08/2026, dos veces). Lo que SI viaja es
# config/excluidas_compartidas.txt, que solo se toca a mano y sirve de arranque
# cuando una PC todavia no tiene su lista.
config/excluidas.txt
config/excluidas_broker.txt
config/excluidas_respaldo.txt
*.env
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs (incluidos los rotados: registro_....log.1, .log.2, ...)
*.log
*.log.*
registro_*
logs/

# Reportes de las pasadas del bot (se generan solos; no van al repo)
reportes/

# Codigo de referencia de Marian (propiedad de el; solo referencia visual)
referencia_marian/

# Informes que genera la app (catalogo, ejecuciones, ordenes, trades). El cuadro
# de "guardar como" ofrece por defecto la carpeta de la app, asi que terminan
# aca sin querer. Tienen tus operaciones REALES: no van al repositorio.
*.csv
!config/*.csv
catalogo_*.csv
operaciones_*.csv
ordenes_*.csv
trades_*.csv
etb_*.txt
